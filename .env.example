# LLM Instruct Models Repository — Environment Variables
# Copy this file to .env and fill in the values.
# This file is read by docker-compose.yml (env_file: .env).

# ── Application ──────────────────────────────────────────────
APP_NAME=LLM Instruct Models Repository
APP_VERSION=0.2.0
DEBUG=false

# ── Database (PostgreSQL in Docker) ────────────────────────
# DB_USER / DB_PASSWORD set on the db container (POSTGRES_USER / POSTGRES_PASSWORD).
# DATABASE_URL must use the same password as DB_PASSWORD and host=db (Docker service name).
DB_USER=llm_user
DB_PASSWORD=CHANGE_ME_use_openssl_rand_-hex_16
DATABASE_URL=postgresql+asyncpg://llm_user:DB_PASSWORD_PLACEHOLDER@db:5432/llm_models

# ── JWT Authentication ─────────────────────────────────────
# Generate with: openssl rand -hex 32
# Must be at least 32 characters. Refuses to start if default or too short.
JWT_SECRET_KEY=CHANGE_ME_openssl_rand_-hex_32
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ── Model Storage ──────────────────────────────────────────
# Host path /opt/llm-models is bind-mounted into the backend container.
# On the host: chown 10001:10001 /opt/llm-models
MODEL_STORAGE_PATH=/opt/llm-models
MAX_UPLOAD_SIZE_MB=50000

# ── CORS ───────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=https://llm.cucorn.com

# ── Registration ───────────────────────────────────────────
# Set to false in production. First admin is seeded from ADMIN_* vars.
ALLOW_REGISTRATION=false

# ── Admin Bootstrap ────────────────────────────────────────
# Created on startup only if the users table is empty.
# With ALLOW_REGISTRATION=false, these are the only way to create the first admin.
# ADMIN_PASSWORD is hashed with bcrypt; never log it.
ADMIN_USERNAME=CHANGE_ME
ADMIN_PASSWORD=CHANGE_ME
ADMIN_EMAIL=admin@cucorn.com

# ── Download Tokens ─────────────────────────────────────────
# Short-lived tokens for model downloads (D5).
DOWNLOAD_TOKEN_EXPIRE_MINUTES=5

# ── Allowed File Extensions ────────────────────────────────
# Configured in code (backend/app/core/config.py). Not settable via env var.
