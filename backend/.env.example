# LLM Instruct Models Repository - Environment Variables
# Copy this file to .env and update the values

# Application
APP_NAME=LLM Instruct Models Repository
APP_VERSION=0.2.0
DEBUG=false

# Database
# PostgreSQL (production): postgresql+asyncpg://user:password@host:5432/dbname
# SQLite (development): sqlite+aiosqlite:///./llm_models.db
DATABASE_URL=sqlite+aiosqlite:///./llm_models.db

# JWT Authentication
# Generate a secure secret with: openssl rand -hex 32
# MUST be at least 32 characters long in production
JWT_SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Model Storage
# Path to store model files
MODEL_STORAGE_PATH=./models

# Upload Limits
# Maximum upload size in megabytes (50GB default)
MAX_UPLOAD_SIZE_MB=50000

# CORS Configuration
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Registration
# Set to true to allow public registration (false in production)
ALLOW_REGISTRATION=false

# Admin Bootstrap
# Create an admin user on startup if the users table is empty
# ADMIN_USERNAME=myadmin
# ADMIN_PASSWORD=secure_password_here
# ADMIN_EMAIL=admin@cucorn.com

# Download Tokens
# Expiration time for download tokens in minutes
DOWNLOAD_TOKEN_EXPIRE_MINUTES=5

# Upload Temp Directory
# Override the default temp directory for uploads
# Defaults to <MODEL_STORAGE_PATH>/.tmp
# UPLOAD_TMP_DIR=/tmp/llm-uploads

# Allowed File Extensions
# Comma-separated list of allowed file extensions
ALLOWED_EXTENSIONS=.gguf,.pt,.pth,.safetensors,.onnx,.tar,.zip,.gz,.bin
